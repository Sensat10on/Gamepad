# Copy this file to keystore.properties (it is git-ignored) and fill in a REAL upload key.
# Never commit the keystore or its passwords.
#
# Generate the key once with:
#   keytool -genkeypair -v -keystore release.jks -alias gamepad -keyalg RSA -keysize 4096 -validity 10000
#
# Then build a signed release with:
#   ./gradlew.bat clean lint testDebugUnitTest assembleRelease
#   apksigner verify --print-certs app/build/outputs/apk/release/app-release.apk

storeFile=release.jks
storePassword=CHANGE_ME
keyAlias=gamepad
keyPassword=CHANGE_ME
